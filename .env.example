# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Postgres (https://console.neon.tech -> your project -> Connect).
# Use the pooled connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Encryption key for everything stored in the database.
# Generate one with:  openssl rand -base64 32
# Keep it secret and back it up. If it is lost, stored data cannot be recovered.
VAULT_ENCRYPTION_KEY=

# Optional: Neon's direct (non-pooled) connection string. If set, `npm run db:migrate`
# uses it instead of DATABASE_URL, which is the recommended setup for migrations.
DIRECT_URL=
